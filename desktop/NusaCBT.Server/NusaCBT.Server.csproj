<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\public\favicon.ico</ApplicationIcon>
    <AssemblyName>NusaCBT-Server</AssemblyName>
    <RootNamespace>NusaCBT.Server</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>NusaCBT</Authors>
    <Product>NusaCBT Server Launcher</Product>
    <Description>Launcher, pemeriksa dependensi, dan pembaruan aplikasi NusaCBT Server untuk Windows</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
