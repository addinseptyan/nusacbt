# Salin menjadi .env.local di komputer server. Jangan commit .env.local.
# Contoh ini untuk PostgreSQL di komputer yang sama dengan aplikasi.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nusacbt
PGUSER=nusacbt_app
PGPASSWORD=

# Default: false saat npm run dev, true saat NODE_ENV=production.
# Gunakan HTTPS tepercaya untuk produksi. false hanya untuk pengujian HTTP terisolasi.
# NUSACBT_COOKIE_SECURE=true

# Path absolut ke file kunci sandi peserta di LUAR direktori proyek.
# Buat dengan: npm run participant:key:create -- /path/aman/di-luar-proyek/participant.key
# Jangan isi kunci itu sendiri di sini; cadangkan file kunci secara aman dan terpisah.
# NUSACBT_PARTICIPANT_KEY_FILE=/path/aman/di-luar-proyek/participant.key

# Kunci token 6 angka TERPISAH dari kunci sandi peserta, di luar proyek.
# Buat sekali: npm run token:key:create -- /path/aman/di-luar-proyek/exam-token.key
# Cadangkan file kunci token secara aman; kehilangan kunci membuat kode lama tak bisa dibuka.
# NUSACBT_EXAM_TOKEN_KEY_FILE=/path/aman/di-luar-proyek/exam-token.key
